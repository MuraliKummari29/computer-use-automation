{
  "schemaVersion": "1.0",
  "id": "coreserv.member.read_balances",
  "name": "Read member share balances",
  "version": "1.0.0",
  "status": "approved",
  "description": "Look up a member by member number and read their savings and checking balances.",
  "usage": {
    "whenToUse": "The agent needs a member's current savings/checking balance and the core exposes no API for it.",
    "notFor": "Loans, cards, or any change to the account."
  },
  "app": {
    "vendor": "CoreServ",
    "profile": "coreserv",
    "surface": "web",
    "entryUrl": "http://localhost:4310/",
    "recordedOnTenant": "harbor",
    "versionObserved": "CoreServ 7.2.14"
  },
  "params": [
    {
      "name": "memberNumber",
      "type": "string",
      "description": "The institution's member number",
      "required": true,
      "sensitive": true,
      "pattern": "^\\d{4,10}$",
      "example": "10001"
    }
  ],
  "outputs": [
    {
      "name": "memberName",
      "type": "string",
      "description": "Member display name",
      "sensitive": true
    },
    {
      "name": "savingsBalance",
      "type": "currency",
      "description": "Current balance of the primary savings share (S01)",
      "sensitive": false
    },
    {
      "name": "checkingBalance",
      "type": "currency",
      "description": "Current balance of the everyday checking share (S05)",
      "sensitive": false
    }
  ],
  "steps": [
    {
      "id": "open",
      "action": "navigate",
      "url": "{entryUrl}",
      "description": "Open the console",
      "tags": [
        "auth"
      ],
      "risk": "read",
      "expect": {
        "allOf": [
          {
            "kind": "title",
            "contains": "Operator Sign In"
          }
        ],
        "timeoutMs": 8000
      },
      "timeoutMs": 8000
    },
    {
      "id": "user",
      "action": "type",
      "description": "Enter operator id",
      "tags": [
        "auth"
      ],
      "risk": "reversible",
      "target": {
        "strategies": [
          {
            "kind": "anchor",
            "anchorText": "Operator ID",
            "relation": "same-row",
            "controlRole": "textbox"
          }
        ],
        "frame": "main",
        "rationale": "Legacy form: label cell to the left of the input, no <label for>."
      },
      "value": {
        "kind": "secret",
        "name": "CORESERV_USER"
      },
      "clear": true,
      "timeoutMs": 8000
    },
    {
      "id": "pass",
      "action": "type",
