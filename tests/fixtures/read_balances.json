      "value": {
        "kind": "secret",
        "name": "CORESERV_PASSWORD"
      },
      "clear": true,
      "timeoutMs": 8000
    },
    {
      "id": "signin",
      "action": "click",
      "description": "Sign in",
      "tags": [
        "auth"
      ],
      "risk": "reversible",
      "target": {
        "strategies": [
          {
            "kind": "role",
            "role": "button",
            "name": "Sign In",
            "exact": true
          },
          {
            "kind": "bbox",
            "x": 455,
            "y": 235,
            "w": 54,
            "h": 20,
            "viewport": {
              "w": 1280,
              "h": 900
            },
            "expectRole": "button"
          }
        ],
        "frame": "main"
      },
      "expect": {
        "allOf": [
          {
            "kind": "title",
            "contains": "Member Lookup"
          }
        ],
        "timeoutMs": 8000
      },
      "timeoutMs": 8000
    },
    {
      "id": "member-number",
      "action": "type",
      "description": "Enter the member number",
      "tags": [],
      "risk": "reversible",
      "target": {
        "strategies": [
          {
            "kind": "anchor",
            "anchorText": "Member Number",
            "relation": "same-row",
            "controlRole": "textbox"
          }
        ],
        "frame": "main",
        "rationale": "Label cell text is the only stable handle; the input has no name attribute we trust."
      },
      "value": {
        "kind": "param",
        "name": "memberNumber"
      },
      "clear": true,
      "timeoutMs": 8000
