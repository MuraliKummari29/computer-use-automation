{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "allowedOrigins": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedPaths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deniedPaths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedActions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "navigate",
          "click",
          "type",
          "select",
          "press",
          "extract",
          "wait"
        ]
      }
    },
    "irreversible": {
      "type": "object",
      "properties": {
        "matchers": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "control-name"
                  },
                  "pattern": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "pattern"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "url"
                  },
                  "pattern": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "pattern"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "mode": {
          "default": "require-approval",
          "type": "string",
          "enum": [
            "block",
            "require-approval",
            "flag"
          ]
        }
      },
      "required": [
        "matchers",
        "mode"
      ],
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "properties": {
        "maxSteps": {
          "default": 30,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxDurationMs": {
          "default": 600000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "allowIrreversible": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "maxSteps",
        "maxDurationMs",
        "allowIrreversible"
      ],
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "patterns": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              },
              "replacement": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "pattern",
              "replacement"
            ],
            "additionalProperties": false
          }
        },
        "secretNames": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "patterns",
        "secretNames"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "allowedOrigins",
    "allowedPaths",
    "deniedPaths",
    "allowedActions",
    "irreversible",
    "discovery",
    "redaction"
  ],
  "additionalProperties": false
}